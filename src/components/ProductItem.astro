---
import ShopImage from '~/components/ShopImage.astro';
import EurMoney from '~/components/EurMoney.astro';
import type {ProductSummary} from '~/lib/types';

interface Props {
  product: ProductSummary;
  loading?: 'eager' | 'lazy';
}

/** Products highlighted with a "High demand" badge, e.g. for bot/scalping demos. */
const HIGH_DEMAND_HANDLES = new Set(['men-crewneck']);

const {product, loading} = Astro.props;
const image = product.featuredImage;
const isHighDemand = HIGH_DEMAND_HANDLES.has(product.handle);
---

<a
  href={`/products/${product.handle}`}
  class:list={[
    'group flex flex-col gap-3 overflow-hidden rounded-lg border bg-white no-underline transition hover:no-underline hover:shadow-md',
    isHighDemand
      ? 'border-red-500 ring-2 ring-red-500/30'
      : 'border-neutral-200 hover:border-neutral-400',
  ]}
>
  {image && (
    <div class="relative overflow-hidden rounded-t-lg bg-neutral-100">
      {isHighDemand && (
        <span class="absolute left-2 top-2 z-10 rounded-full bg-red-600 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-white shadow-sm">
          🔥 High demand
        </span>
      )}
      <ShopImage
        image={image}
        alt={image.altText || product.title}
        class="aspect-square h-auto w-full object-cover transition duration-300 group-hover:scale-[1.02]"
        loading={loading}
      />
    </div>
  )}
  <div class="flex flex-col gap-1 px-3 pb-3">
    <h4 class="text-sm font-medium text-neutral-900">{product.title}</h4>
    <small class="text-sm text-neutral-600">
      <EurMoney amount={product.priceRange.minVariantPrice.amount} />
    </small>
  </div>
</a>
