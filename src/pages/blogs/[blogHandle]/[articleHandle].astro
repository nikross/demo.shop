---
import Layout from '~/layouts/Layout.astro';
import ShopImage from '~/components/ShopImage.astro';
import {getArticle} from '~/lib/catalog';

const {blogHandle, articleHandle} = Astro.params;
const result =
  blogHandle && articleHandle ? getArticle(blogHandle, articleHandle) : undefined;
if (!result) return Astro.redirect('/404');
const {article} = result;
---

<Layout title={`Shop | ${article.title}`}>
  <article class="mx-auto flex max-w-3xl flex-col gap-6">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">{article.title}</h1>
    {article.image && (
      <ShopImage image={article.image} alt={article.title} class="w-full rounded-lg object-cover" />
    )}
    <div
      class="prose-neutral text-neutral-600 leading-relaxed"
      set:html={article.contentHtml ?? article.content}
    />
  </article>
</Layout>
