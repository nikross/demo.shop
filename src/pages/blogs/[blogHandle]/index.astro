---
import Layout from '~/layouts/Layout.astro';
import Pagination from '~/components/Pagination.astro';
import ShopImage from '~/components/ShopImage.astro';
import {getBlogByHandle, paginate} from '~/lib/catalog';
import {getPaginationVariables} from '~/lib/pagination';

const {blogHandle} = Astro.params;
const blog = blogHandle ? getBlogByHandle(blogHandle) : undefined;
if (!blog) return Astro.redirect('/404');

const pagination = getPaginationVariables(Astro.request, {pageBy: 4});
const articles = paginate(blog.articles, pagination);
---

<Layout title={`Shop | ${blog.title}`}>
  <div class="flex flex-col gap-8">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">{blog.title}</h1>
    <Pagination connection={articles}>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {articles.nodes.map((article) => (
          <a
            href={`/blogs/${blog.handle}/${article.handle}`}
            class="group flex flex-col gap-3 overflow-hidden rounded-lg border border-neutral-200 bg-white no-underline transition hover:border-neutral-400 hover:shadow-md"
          >
            {article.image && (
              <ShopImage
                image={article.image}
                alt={article.image.altText || article.title}
                class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.02]"
              />
            )}
            <div class="px-3 pb-3">
              <h2 class="text-lg font-medium text-neutral-900">{article.title}</h2>
            </div>
          </a>
        ))}
      </div>
    </Pagination>
  </div>
</Layout>
