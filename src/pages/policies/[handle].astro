---
import Layout from '~/layouts/Layout.astro';
import {getPolicyByHandle} from '~/lib/catalog';

const {handle} = Astro.params;
const policy = handle ? getPolicyByHandle(handle) : undefined;
if (!policy) return Astro.redirect('/404');
---

<Layout title={`Shop | ${policy.title}`}>
  <div class="mx-auto flex max-w-3xl flex-col gap-6">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">{policy.title}</h1>
    <div class="prose-neutral text-neutral-600 leading-relaxed" set:html={policy.body} />
  </div>
</Layout>
