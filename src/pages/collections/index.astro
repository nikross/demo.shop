---
import Layout from '~/layouts/Layout.astro';
import Pagination from '~/components/Pagination.astro';
import ShopImage from '~/components/ShopImage.astro';
import {getAllCollections, paginate} from '~/lib/catalog';
import {getPaginationVariables} from '~/lib/pagination';

const pagination = getPaginationVariables(Astro.request, {pageBy: 4});
const collections = paginate(getAllCollections(), pagination);
---

<Layout title="Shop | Collections">
  <div class="flex flex-col gap-8">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">Collections</h1>
    <Pagination connection={collections}>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {collections.nodes.map((collection) => (
          <a
            href={`/collections/${collection.handle}`}
            class="group flex flex-col gap-3 overflow-hidden rounded-lg border border-neutral-200 bg-white no-underline transition hover:border-neutral-400 hover:shadow-md"
          >
            {collection.image && (
              <ShopImage
                image={collection.image}
                alt={collection.image.altText || collection.title}
                class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.02]"
              />
            )}
            <h2 class="px-3 pb-3 text-lg font-medium text-neutral-900">{collection.title}</h2>
          </a>
        ))}
      </div>
    </Pagination>
  </div>
</Layout>
