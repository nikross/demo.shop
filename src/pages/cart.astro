---
import Layout from '~/layouts/Layout.astro';
import {CartMain} from '~/components/CartMain';

const cart = await Astro.locals.cart.get();
---

<Layout title="Shop | Cart">
  <div class="flex flex-col gap-8">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-900">Cart</h1>
    <CartMain client:load cart={cart} layout="page" />
  </div>
</Layout>
